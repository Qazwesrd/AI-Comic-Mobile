APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-secret
TOKEN_PEPPER=replace-with-a-separate-random-secret
DATABASE_URL=sqlite:///./ai_comic_mobile.db
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_BASE_URL=http://localhost:3000
ACCESS_TOKEN_MINUTES=1440
TRIAL_HOURS=72
SESSION_COOKIE_SAMESITE=lax
MAX_ACTIVE_DEVICES=3

# SMTP: required in production when REQUIRE_EMAIL_VERIFICATION=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
REQUIRE_EMAIL_VERIFICATION=false
RATE_LIMIT_AUTH_PER_MINUTE=8
RATE_LIMIT_EMAIL_PER_HOUR=5

# Optional OpenAI-compatible chat completions endpoint; base URL should normally end in /v1
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=120

# Configure an approved payment adapter before taking real payments.
# Placeholder only; a real provider-specific checkout adapter is still required.
PAYMENT_CHECKOUT_URL=
PAYMENT_WEBHOOK_SECRET=

# Comma-separated bootstrap administrator emails
ADMIN_BOOTSTRAP_EMAILS=

MEDIA_ROOT=./storage/media
MAX_UPLOAD_BYTES=2147483648
